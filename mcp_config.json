{
  "mcpServers": {
    "chrome-devtools": {
      "command": "py",
      "args": [
        "-3",
        "${PLUGIN_ROOT}/bin/cua_window_glow_proxy.py",
        "--devtools-proxy",
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ],
      "env": {
        "CUA_GLOW_COLOR": "auto",
        "CUA_GLOW_HOLD_SEC": "3.5"
      }
    },
    "cua-driver": {
      "command": "py",
      "args": [
        "-3",
        "${PLUGIN_ROOT}/bin/cua_window_glow_proxy.py",
        "mcp",
        "--grant",
        "existing-profile"
      ],
      "env": {
        "CUA_GLOW_COLOR": "auto",
        "CUA_GLOW_HOLD_SEC": "3.5",
        "CUA_AUTO_UPDATE": "true",
        "CUA_AUTO_UPDATE_INTERVAL_HOURS": "6"
      }
    }
  }
}
